{
  "name": "OpenArm ROS2",
  "build": {
    "dockerfile": "Dockerfile",
    "options": ["--network=host"]
  },
  "runArgs": [
    "--network=host",
    "--privileged",
    "-e", "DISPLAY",
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/openarm_ws/src,type=bind",
  "workspaceFolder": "/openarm_ws/src",
  "postCreateCommand": "bash /openarm_ws/src/.devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-iot.vscode-ros",
        "ms-python.python"
      ],
      "settings": {
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--compile-commands-dir=/openarm_ws/build",
          "--background-index",
          "--clang-tidy",
          "--header-insertion=never",
          "--completion-style=detailed"
        ],
        "C_Cpp.intelliSenseEngine": "disabled"
      }
    }
  }
}